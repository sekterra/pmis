# frontend/.env.local 로 복사한 뒤 값을 채운다.
# 비밀번호, 토큰, 계정은 넣지 않는다. 개발 서버 주소와 테넌트 코드만 둔다.
# 이 파일에 적힌 키는 셸의 같은 이름보다 우선한다. 파일에 없는 키만 셸 값을 유지한다.
# .env 가 있으면 그 다음 .env.local 이 같은 키를 덮어쓴다. 빈 값도 키가 있으면 셸 값을 지운다.

# 예: http://<host>:<port>
DEV_BACKEND_URL=

# 개발 프록시가 /api/mdm 요청에만 X-Tenant-Code 로 붙인다. /api/platform 에는 붙이지 않는다.
# 값이 있으면 테넌트 화면, 비우면 플랫폼 콘솔이다.
DEV_TENANT_CODE=

# 비워 두면 8000이다. 숫자를 적으면 그 포트를 쓴다.
# PORT=
